# --- Correo (Gmail) para verificación, recuperación y promociones ---
# Usa una "contraseña de aplicación" de Gmail, NUNCA tu contraseña normal.
GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Chatbot (OpenRouter) ---
# IMPORTANTE: nunca pongas esta key en el frontend. Solo aquí, en el backend.
# La key que compartiste en el chat quedó expuesta: revócala y genera una nueva.
