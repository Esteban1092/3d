# --- Supabase (Postgres) ---
# La "secret key"/service role NUNCA va en el frontend, solo aquí en el backend.
# La que compartiste en el chat quedó expuesta: regenérala en Project Settings > API.
SUPABASE_URL=https://waiqeqfqegqcuuklvszy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloca_aqui_tu_nueva_service_role_key
# La "anon/public key" sí puede ir en el frontend (respeta las políticas RLS)
